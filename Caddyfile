# HTTPS-Zertifikat wird automatisch geholt und verlängert (Let's Encrypt)
{$DOMAIN}, www.{$DOMAIN} {
	# IP-Sperre ist ausgeschaltet – die Seite ist öffentlich erreichbar.
	# Wieder einschalten: die beiden folgenden Zeilen entkommentieren (ALLOWED_IPS in .env).
	# @fremd not remote_ip {$ALLOWED_IPS}
	# respond @fremd "Kein Zugriff" 403

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	encode zstd gzip
	header {
		# HTTPS-Pflicht auch für alle Subdomains (keine braucht unverschlüsseltes HTTP, s. LIESMICH) – verhindert, dass über eine
		# erfundene unverschlüsselte Subdomain Cookies für die Seite untergeschoben werden. Merkdauer zunächst 1 Tag (Probe),
		# danach auf 1 Jahr (31536000) erhöhen.
		Strict-Transport-Security "max-age=86400; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		# Nur eigene Skripte/Daten – schützt vor eingeschleustem Code (XSS) und Einbettung in fremde Seiten
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Resource-Policy "same-origin"
		# Browser fragen bei jeder Datei kurz nach, ob es eine neue Fassung gibt (Antwort meist „unverändert“).
		# Verhindert veraltete Skripte nach einem Release. Eigene Angaben der Anwendung bleiben unberührt.
		?Cache-Control "no-cache"
		-Server
		-X-Powered-By
	}
	# Skripte und Stylesheets mit Inhalts-Prüfsumme in der Adresse (?v=…, werkzeuge/asset_versionen.py) ändern sich nie:
	# ein Jahr zwischenspeichern – eine neue Fassung hat eine neue Adresse. Alles andere fragt weiter nach („no-cache“).
	@versioniert {
		path /assets/*
		query v=*
	}
	header @versioniert >Cache-Control "public, max-age=31536000, immutable"
	@private path /data /data/*
	respond @private 404
	# Falle: typische Pfade von Angriffswerkzeugen (diese Seite hat keine davon) → Firewall zählt und sperrt automatisch
	@falle path /wp-login.php /xmlrpc.php /wp-admin /wp-admin/* /wp-content/* /wp-includes/* /.env /.env.* /.git /.git/* /phpmyadmin* /pma/* /myadmin* /vendor/phpunit/* /cgi-bin/* /.aws/* /server-status /actuator* /admin.php /administrator/* /boaform/* /HNAP1*
	rewrite @falle /api/index.php?action=waf_probe&p={path}
	reverse_proxy app:80
}

# Testumgebung: test.<Domain> → Container „app-test“ (Ordner /opt/wochenangebot-test, deploy/testumgebung.sh).
# Nur Testdaten, Zugang zusätzlich per Passwort (Apache im Test-Container), keine Suchmaschinen.
# Läuft der Test-Container nicht, antwortet nur diese Adresse mit einem Fehler – der Echtbetrieb ist unberührt.
test.{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		?Cache-Control "no-cache"
		-Server
		-X-Powered-By
	}
	# Skripte und Stylesheets mit Inhalts-Prüfsumme in der Adresse (?v=…, werkzeuge/asset_versionen.py) ändern sich nie:
	# ein Jahr zwischenspeichern – eine neue Fassung hat eine neue Adresse. Alles andere fragt weiter nach („no-cache“).
	@versioniert {
		path /assets/*
		query v=*
	}
	header @versioniert >Cache-Control "public, max-age=31536000, immutable"
	@private path /data /data/*
	respond @private 404
	# Falle: typische Pfade von Angriffswerkzeugen (diese Seite hat keine davon) → Firewall zählt und sperrt automatisch
	@falle path /wp-login.php /xmlrpc.php /wp-admin /wp-admin/* /wp-content/* /wp-includes/* /.env /.env.* /.git /.git/* /phpmyadmin* /pma/* /myadmin* /vendor/phpunit/* /cgi-bin/* /.aws/* /server-status /actuator* /admin.php /administrator/* /boaform/* /HNAP1*
	rewrite @falle /api/index.php?action=waf_probe&p={path}
	reverse_proxy app-test:80
}

# STAFL-Plattform: vorbereitete Domains ohne öffentlich erreichbare Mitarbeiter-Anwendung.
# Erst nach fertiger Anmeldung, Rechteprüfung und geprüfter Release-Freigabe pro Modul routen.
# Bis dahin: keine Weiterleitung an die produktive Angebots-API oder interne Container.
dashboard-stafl.de, bestand.dashboard-stafl.de, crm.dashboard-stafl.de, rewe.dashboard-stafl.de, qs.dashboard-stafl.de, einkauf.dashboard-stafl.de, verwaltung.dashboard-stafl.de, test.dashboard-stafl.de {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	respond "STAFL-Plattform: Dieser Bereich befindet sich in Vorbereitung." 503
}

# Die WWW-Adresse des Dashboards dient nur als Weiterleitung auf den zentralen Einstieg.
www.dashboard-stafl.de {
	redir https://dashboard-stafl.de{uri} 308
}

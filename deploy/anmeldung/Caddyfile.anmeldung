# STAFL-Plattform – neue Hosts für die zentrale Anmeldung (ADR-003). NOCH NICHT AKTIV.
# Bei der Inbetriebnahme ersetzt dieser Teil im Caddyfile den 503-Platzhalter für dashboard-stafl.de und ergänzt
# login. und angebot. (Schritt „Caddy“ in docs/plattform/inbetriebnahme-anmeldung.md). Die übrigen Modul-Hosts bleiben
# Platzhalter, bis das jeweilige Modul freigegeben ist (GR-105).

# Keycloak: nur der Realm „mitarbeiter“ und statische Dateien; Verwaltung und Master-Realm nie öffentlich
login.dashboard-stafl.de {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	@anmeldung path /realms/mitarbeiter/* /resources/*
	handle @anmeldung {
		reverse_proxy keycloak:8080
	}
	respond 404
}

# Dashboard und Mitarbeiter-Eingabe: dieselbe Anwendung, je Host eigener Client und eigene Sitzung (GR-108)
dashboard-stafl.de, angebot.dashboard-stafl.de {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://login.dashboard-stafl.de; frame-ancestors 'self'; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow"
		?Cache-Control "no-cache"
		-Server
		-X-Powered-By
	}
	@private path /data /data/*
	respond @private 404
	reverse_proxy app:80
}

  "authenticationFlows": [
    {
      "alias": "mitarbeiter-browser",
      "description": "Mitarbeiter: Passwort (Stufe 1) und zweiter Faktor (Stufe 2, Pflicht)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "auth-cookie",
          "authenticatorFlow": false
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-formulare",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "mitarbeiter-formulare",
      "description": "Anmeldestufen",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-stufe-1",
          "authenticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-stufe-2",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "mitarbeiter-stufe-1",
      "description": "Stufe 1: Benutzername und Passwort",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "stufe-1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "mitarbeiter-stufe-2",
      "description": "Stufe 2: zweiter Faktor – Passkey oder Einmalcode",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorFlow": false,
          "authenticatorConfig": "stufe-2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-zweiter-faktor",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "mitarbeiter-zweiter-faktor",
      "description": "Passkey, wenn eingerichtet – sonst Einmalcode (Einrichtung erzwungen)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-mit-passkey",
          "authenticatorFlow": true
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "flowAlias": "mitarbeiter-mit-einmalcode",
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "mitarbeiter-mit-passkey",
      "description": "nur wenn der Nutzer einen Passkey hat",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "webauthn-authenticator",
          "authenticatorFlow": false
        }
      ]
    },
    {
      "alias": "mitarbeiter-mit-einmalcode",
      "description": "wenn kein Passkey verwendet wurde",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticator": "conditional-credential",
          "authenticatorFlow": false,
          "authenticatorConfig": "ohne-passkey"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "stufe-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "stufe-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "ohne-passkey",
      "config": {
        "credentials": "webauthn",
        "included": "false"
      }
    }
  ],

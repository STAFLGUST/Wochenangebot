        "post.logout.redirect.uris": "https://dashboard.stafl.test:8443/dashboard/abgemeldet.html",
        "backchannel.logout.url": "https://dashboard.stafl.test:8443/oidc/callback?logout=backchannel",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "false",

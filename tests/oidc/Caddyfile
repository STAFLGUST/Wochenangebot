# Testumgebung „Anmeldung über Keycloak“ (nur CI und lokal, GR-111) – bildet die Produktion nach: Caddy beendet TLS
# (hier mit eigener Test-CA), setzt X-Forwarded-*, Keycloak und die Anwendung laufen dahinter nur auf 127.0.0.1.
{
	admin off
	local_certs
	skip_install_trust
	auto_https disable_redirects
	http_port {$OIDC_HTTP_PORT}
	https_port {$OIDC_PORT}
	storage file_system {$OIDC_WORK}/caddy
	servers {
		trusted_proxies static private_ranges
	}
}

# Keycloak: nur der Anmeldeteil; Verwaltungsoberfläche und -schnittstelle nie über den öffentlichen Host (ADR-003)
login.stafl.test {
	tls internal
	@anmeldung path /realms/mitarbeiter/* /resources/*
	handle @anmeldung {
		# Vor jeder Seite der Anmeldung: Firewall-Sperren, Ländersperre und IP-Freigabe des Eingabebereichs – die Anwendung prüft
		# wie bei jeder Mitarbeiter-Aktion (Aktion anmeldung_pruefen, Einstellungen unter Sicherheit). Nicht geprüft: Dateien der
		# Anmeldeseite und die Abrufe der Anwendung selbst (Metadaten, Schlüssel, Token – vom Server, nicht vom Browser).
		# Cookies und Herkunftsangaben des Browsers gehen nicht an die Anwendung; Keycloak bekommt die Anfrage unverändert.
		@seite not path /resources/* /realms/mitarbeiter/.well-known/* /realms/mitarbeiter/protocol/openid-connect/token /realms/mitarbeiter/protocol/openid-connect/token/introspect /realms/mitarbeiter/protocol/openid-connect/certs /realms/mitarbeiter/protocol/openid-connect/userinfo /realms/mitarbeiter/protocol/openid-connect/revoke
		forward_auth @seite 127.0.0.1:{$APACHE_PORT} {
			uri /api/index.php?action=anmeldung_pruefen
			header_up -Cookie
			header_up -Authorization
			header_up -Origin
			header_up -Sec-Fetch-*
			@gesperrt status 403
			handle_response @gesperrt {
				respond "Die Anmeldung ist von hier aus nicht möglich (Länder- oder Adresssperre)." 403
			}
			@fehler status 4xx 5xx
			handle_response @fehler {
				respond "Die Anmeldung ist gerade nicht erreichbar. Bitte später erneut versuchen." 503
			}
		}
		reverse_proxy 127.0.0.1:{$KC_PORT}
	}
	respond 404
	# Anwendung oder Keycloak nicht erreichbar (z. B. kurz während eines Releases)
	handle_errors 502 503 504 {
		respond "Die Anmeldung ist gerade nicht erreichbar. Bitte später erneut versuchen." 503
	}
}

# Anwendungen: jede auf eigenem Host, eigene Sitzung (GR-108)
dashboard.stafl.test, angebot.stafl.test, verwaltung.stafl.test, bestand.stafl.test, hr.stafl.test, crm.stafl.test, marketing.stafl.test, sicherheit.stafl.test, controlling.stafl.test {
	tls internal
	reverse_proxy 127.0.0.1:{$APACHE_PORT}
}

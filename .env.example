# Kopie als .env auf dem Server anlegen
DOMAIN=angebot-stafl.de
# Erlaubte öffentliche IP-Adressen (mit Leerzeichen getrennt; Beispieladresse ersetzen). Für alle freigeben: 0.0.0.0/0
ALLOWED_IPS=203.0.113.10

# E-Mail-Versand an Kunden (Angebotsportal). Einfacher: im Eingabebereich unter Verwaltung → E-Mail eintragen
# (hat Vorrang vor diesen Werten). Leer lassen = Versand ausgeschaltet bzw. nur Eingabebereich.
# Empfehlung: eigenes Postfach bei IONOS, z. B. angebot@standard-fleisch.de
# Passwort in einfache Anführungszeichen setzen, damit Sonderzeichen wie $ unverändert bleiben.
MAIL_SMTP_HOST=smtp.ionos.de
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=starttls
MAIL_SMTP_USER=angebot@standard-fleisch.de
MAIL_SMTP_PASS='hier-das-Postfach-Passwort'
MAIL_FROM=angebot@standard-fleisch.de
MAIL_FROM_NAME=Standard-Fleisch
MAIL_REPLY_TO=

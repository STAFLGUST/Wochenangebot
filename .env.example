# Kopie als .env auf dem Server anlegen
DOMAIN=angebot-stafl.de
# Erlaubte öffentliche IP-Adressen (mit Leerzeichen getrennt; Beispieladresse ersetzen). Für alle freigeben: 0.0.0.0/0
ALLOWED_IPS=203.0.113.10

# bunny.net (CDN) vor dem Server – Anleitung docs/bunny-cdn.md. Leer = ohne CDN (wie bisher).
# CDN_SCHLUESSEL: geheimer Schlüssel, den bunny bei jeder Anfrage mitschickt (32–128 Buchstaben/Ziffern):
#   openssl rand -hex 32   – derselbe Wert gehört in die bunny-Regel „X-Stafl-Cdn“, sonst nirgendwohin.
# CDN_PFLICHT=1: nur noch Anfragen über bunny annehmen (erst einschalten, wenn alle Adressen über bunny laufen).
# Nach einer Änderung: docker compose up -d caddy
CDN_SCHLUESSEL=
CDN_PFLICHT=0

# Externe Kopie der Datensicherung auf eine Hetzner Storage Box – Anleitung docs/plattform/inbetriebnahme-sicherung-extern.md.
# Zugang des Unterkontos in der Form <Benutzer>@<Benutzer>.your-storagebox.de; leer = keine externe Kopie.
# Danach: sh deploy/sicherung-extern.sh einrichten. Optional Totmannschalter: HC_SICHERUNG_EXTERN_URL=https://…
SICHERUNG_EXTERN_ZIEL=

# E-Mail-Versand an Kunden (Angebotsportal). Einfacher: im Eingabebereich unter Verwaltung → E-Mail eintragen
# (hat Vorrang vor diesen Werten). Leer lassen = Versand ausgeschaltet bzw. nur Eingabebereich.
# Empfehlung: eigenes Postfach bei IONOS, z. B. angebot@standard-fleisch.de
# Passwort in einfache Anführungszeichen setzen, damit Sonderzeichen wie $ unverändert bleiben.
MAIL_SMTP_HOST=smtp.ionos.de
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=starttls
MAIL_SMTP_USER=angebot@standard-fleisch.de
MAIL_SMTP_PASS='hier-das-Postfach-Passwort'
MAIL_FROM=angebot@standard-fleisch.de
MAIL_FROM_NAME=Standard-Fleisch
MAIL_REPLY_TO=

# Whisp (FAO, https://whisp.openforis.org) – automatische Abfrage im Container-Import (EUDR, eigene Gegenprüfung).
# Schlüssel von der Kontoseite bei Whisp (kostenlose Registrierung, ein Jahr gültig); leer = Abfrage ausgeschaltet.
# Nach einer Änderung: docker compose up -d app-mitarbeiter – Anleitung docs/plattform/inbetriebnahme-containerimport.md
WHISP_API_KEY=

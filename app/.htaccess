# Wochenangebot – Webserver-Einstellungen (Hostinger / LiteSpeed / Apache)
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  # Wie im Caddyfile: nur eigene Skripte (Schutz vor eingeschleustem Code), keine Einbettung in fremde Seiten
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # HTTPS erzwingen (nur über HTTPS gesendet)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always unset X-Powered-By
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Data files, including SQLite journals, must never be served directly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data(?:/|$) - [F,L,NC]
  # Falle für Angriffswerkzeuge (wie im Caddyfile): Firewall zählt Treffer und sperrt automatisch
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-content|wp-includes|\.env|\.git|phpmyadmin|pma|myadmin|vendor/phpunit|cgi-bin|\.aws|server-status|actuator|administrator|admin\.php|boaform)(?:[/.].*)?$ api/index.php?action=waf_probe&p=$1 [L,NC]
</IfModule>
